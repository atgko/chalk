# Copy this file to .env and fill in your provider's credentials.
# .env is gitignored — it is never committed. See README section 8 for full
# setup instructions for each provider.

# --- OpenAI (default) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=
# LLM_MODEL=claude-sonnet-5

# --- University-hosted local model (Ollama — OpenAI-compatible) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:70b
