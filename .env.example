# You usually don't need this file: the app's first-run screen / Settings tab
# saves your provider once for every course, in this computer's password store.
# To give one course different settings, copy this file into its project folder
# as .env and fill in all four values; a complete .env overrides the saved one.
# .env is gitignored — it is never committed. See README section 8 for full
# setup instructions for each provider.

# --- OpenAI (default) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=
# LLM_MODEL=claude-sonnet-5

# --- Google Gemini (not sanctioned by the university; course materials only) ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIza...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite

# --- University-hosted local model (Ollama — OpenAI-compatible) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:70b
